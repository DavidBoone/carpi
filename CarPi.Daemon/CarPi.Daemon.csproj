<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Measured on pi0 2026-08-20, five samples each at 300-420 s after start,
         identical warm-up: server+concurrent 95-103 MB, workstation+concurrent
         101 MB, workstation+non-concurrent 101 MB. GC mode is worth ~1 MB of RSS
         either way — the managed heap is only ~28 MB of the ~101 MB, the rest is
         mapped runtime. Workstation is kept for the 6 fewer threads and because
         server GC grew +16 MB under a real drive sample; concurrent goes back on
         because turning it off bought nothing. The RSS lever is
         DOTNET_EnableWriteXorExecute=0 in carpi-daemon.service (-26 MB). -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <AssemblyName>carpi-daemon</AssemblyName>
    <RootNamespace>CarPi.Daemon</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CarPi.Obd\CarPi.Obd.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
